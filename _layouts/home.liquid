---
layout: default
---
{%- comment -%}
  Home page layout for debmandal.github.io.
  A new layout (not an override of a gem file), so al-folio upgrades never touch it.
  Content comes from _pages/about.md (front matter + bio), _data/research.yml,
  _data/group.yml, _news/ and the `selected = {true}` entries in papers.bib.
{%- endcomment -%}
{%- assign full_name = site.first_name | append: ' ' | append: site.last_name -%}
<div class="dm-home">
  <section class="dm-hero" aria-label="Introduction">
    {% if page.profile.image %}
      <img
        class="dm-portrait"
        src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
        alt="Portrait of {{ full_name }}"
        width="200"
        height="240"
      >
    {% endif %}
    <div class="dm-hero-text">
      <h1 class="dm-name">{{ full_name }}</h1>
      {% if page.subtitle %}<p class="dm-role">{{ page.subtitle }}</p>{% endif %}
      {% if page.pitch %}<p class="dm-pitch">{{ page.pitch }}</p>{% endif %}
      <div class="dm-bio">{{ content }}</div>
      {% if page.buttons %}
        <div class="dm-actions">
          {% for b in page.buttons %}
            {%- capture btn_class %}dm-btn{% if forloop.first %} dm-btn-primary{% endif %}{% endcapture -%}
            {% if b.reveal_email and page.email %}
              <button
                type="button"
                class="{{ btn_class }} dm-email-reveal"
                data-u="{{ page.email.user | split: '' | reverse | join: '' }}"
                data-d="{{ page.email.domain | split: '' | reverse | join: '' }}"
                aria-label="Show email address"
              >
                {%- if b.icon %}<i class="{{ b.icon }}" aria-hidden="true"></i>{% endif -%}
                {{- b.label -}}
              </button>
            {% else %}
              <a class="{{ btn_class }}" href="{{ b.url | relative_url }}">
                {%- if b.icon %}<i class="{{ b.icon }}" aria-hidden="true"></i>{% endif -%}
                {{- b.label -}}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  {% if page.email %}
    <script>
      // Email button: the address is stored reversed in two parts and only assembled on click,
      // so it never appears whole in the page source.
      document.addEventListener("click", function (event) {
        var button = event.target.closest(".dm-email-reveal");
        if (!button) return;
        var unreverse = function (text) {
          return text.split("").reverse().join("");
        };
        var shown = document.createElement("span");
        shown.className = "dm-btn dm-email-shown";
        shown.tabIndex = -1;
        shown.textContent = unreverse(button.dataset.u) + "@" + unreverse(button.dataset.d);
        button.replaceWith(shown);
        shown.focus();
        // Select the address so it can be copied straight away.
        var range = document.createRange();
        range.selectNodeContents(shown);
        var selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
      });
    </script>
  {% endif %}

  {% if page.prospective %}
    <section class="dm-callout" aria-labelledby="prospective-h">
      <h2 id="prospective-h">Prospective students</h2>
      <div>{{ page.prospective | markdownify }}</div>
    </section>
  {% endif %}

  {% if site.data.research %}
    <section id="research" class="dm-section" aria-labelledby="research-h">
      <div class="dm-section-head">
        <h2 id="research-h">Research</h2>
        {% if page.research_note %}<p class="dm-section-note">{{ page.research_note }}</p>{% endif %}
      </div>
      {%- comment -%}
        Theme list with a detail panel. Without JavaScript every panel is shown in turn;
        the script below turns them into tabs (one open at a time, arrow keys move between themes).
      {%- endcomment -%}
      <div class="dm-research-tabs">
        <div class="dm-tablist" role="tablist" aria-label="Research themes" aria-orientation="vertical">
          {% for t in site.data.research %}
            <button
              type="button"
              class="dm-tab"
              role="tab"
              id="theme-tab-{{ forloop.index }}"
              aria-controls="theme-panel-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {% unless forloop.first %}
                tabindex="-1"
              {% endunless %}
            >
              {{ t.title }}
            </button>
          {% endfor %}
        </div>
        <div class="dm-tabpanels">
          {% for t in site.data.research %}
            <div class="dm-tabpanel" role="tabpanel" id="theme-panel-{{ forloop.index }}" aria-labelledby="theme-tab-{{ forloop.index }}" tabindex="0">
              <h3>{{ t.title }}</h3>
              <p>{{ t.summary }}</p>
              {% if t.papers %}
                <p class="dm-theme-papers">
                  See:
                  {% for p in t.papers -%}
                    <a href="{{ p.url }}">{{ p.title }}</a>{% unless forloop.last %} · {% endunless %}
                  {%- endfor %}
                </p>
              {% endif %}
              {% if t.topic %}
                <a class="dm-theme-more" href="{{ '/publications/' | relative_url }}#{{ t.topic | downcase | uri_escape }}">All papers on this topic</a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
      <script>
        (function () {
          var root = document.querySelector(".dm-research-tabs");
          if (!root) return;
          var tabs = Array.prototype.slice.call(root.querySelectorAll(".dm-tab"));
          var panels = Array.prototype.slice.call(root.querySelectorAll(".dm-tabpanel"));
          root.classList.add("is-tabbed");
          function select(index, moveFocus) {
            tabs.forEach(function (tab, i) {
              var on = i === index;
              tab.setAttribute("aria-selected", on ? "true" : "false");
              tab.tabIndex = on ? 0 : -1;
              panels[i].hidden = !on;
            });
            if (moveFocus) tabs[index].focus();
          }
          tabs.forEach(function (tab, i) {
            tab.addEventListener("click", function () {
              select(i, false);
            });
            tab.addEventListener("keydown", function (event) {
              var next = null;
              if (event.key === "ArrowDown" || event.key === "ArrowRight") next = (i + 1) % tabs.length;
              if (event.key === "ArrowUp" || event.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
              if (event.key === "Home") next = 0;
              if (event.key === "End") next = tabs.length - 1;
              if (next === null) return;
              event.preventDefault();
              select(next, true);
            });
          });
          select(0, false);
        })();
      </script>
    </section>
  {% endif %}

  <div class="dm-split">
    {% if page.announcements and page.announcements.enabled and site.news != empty %}
      <section class="dm-section" aria-labelledby="news-h">
        <div class="dm-section-head">
          <h2 id="news-h">News</h2>
          <a class="dm-more" href="{{ '/news/' | relative_url }}">All news</a>
        </div>
        {% assign news = site.news | reverse %}
        {% assign news_limit = page.announcements.limit | default: 5 %}
        <ul class="dm-news">
          {% for item in news limit: news_limit %}
            <li>
              <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %Y' }}</time>
              <span>
                {%- if item.inline -%}
                  {{ item.content | remove: '<p>' | remove: '</p>' | strip }}
                {%- else -%}
                  <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {%- endif -%}
              </span>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% if site.data.group.phd %}
      <section id="group" class="dm-section" aria-labelledby="group-h">
        <div class="dm-section-head">
          <h2 id="group-h">Group</h2>
          <a class="dm-more" href="{{ '/group/' | relative_url }}">Group page</a>
        </div>
        {% include dm_group_list.liquid people=site.data.group.phd %}
      </section>
    {% endif %}
  </div>

  {% if page.selected_papers %}
    <section class="dm-section" aria-labelledby="pubs-h">
      <div class="dm-section-head">
        <h2 id="pubs-h">Selected publications</h2>
        <a class="dm-more" href="{{ '/publications/' | relative_url }}">All publications</a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if page.teaching or page.service %}
    <div class="dm-split">
      {% if page.teaching %}
        <section id="teaching" class="dm-section" aria-labelledby="teaching-h">
          <div class="dm-section-head">
            <h2 id="teaching-h">Teaching</h2>
            <a class="dm-more" href="{{ '/teaching/' | relative_url }}">Teaching page</a>
          </div>
          <ul class="dm-plain-list">
            {% for item in page.teaching %}<li>{{ item | markdownify | remove: '<p>' | remove: '</p>' | strip }}</li>{% endfor %}
          </ul>
        </section>
      {% endif %}
      {% if page.service %}
        <section id="service" class="dm-section" aria-labelledby="service-h">
          <div class="dm-section-head">
            <h2 id="service-h">Service</h2>
            <a class="dm-more" href="{{ '/service/' | relative_url }}">Full list</a>
          </div>
          <ul class="dm-plain-list">
            {% for item in page.service %}<li>{{ item | markdownify | remove: '<p>' | remove: '</p>' | strip }}</li>{% endfor %}
          </ul>
        </section>
      {% endif %}
    </div>
  {% endif %}

  <section class="dm-contact" aria-label="Contact">
    {% if page.profile.address %}<address>{{ page.profile.address | markdownify }}</address>{% endif %}
    {% if page.social %}
      <div class="dm-contact-links">
        <div class="contact-icons">{% social_links %}</div>
        {% if site.contact_note %}<p class="contact-note">{{ site.contact_note }}</p>{% endif %}
      </div>
    {% endif %}
  </section>
</div>
